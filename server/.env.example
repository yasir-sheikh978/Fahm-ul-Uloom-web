# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net
MONGODB_DB=fahm_ul_uloom

# Admin login credentials (choose strong values)
ADMIN_EMAIL=admin@fahmululoom.com
ADMIN_PASSWORD=change-this-strong-password

# Secret used to sign admin JWT tokens (any long random string)
JWT_SECRET=change-this-long-random-secret

# Gmail account used to send meeting invitations
# EMAIL_PASS must be a Gmail "App Password" (Google Account > Security > App Passwords)
EMAIL_USER=yourgmail@gmail.com
EMAIL_PASS=your-16-char-app-password

# Comma-separated allowed origins for CORS (your website URLs)
CORS_ORIGIN=http://localhost:5173,https://your-site.vercel.app

# Website URL used in invitation emails (the "Join Your Class" button opens this)
SITE_URL=https://your-site.vercel.app

PORT=5000
