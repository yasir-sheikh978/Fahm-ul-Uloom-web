# URL of the deployed API (server/ folder). Locally leave unset (defaults to http://localhost:5000)
VITE_API_URL=https://your-api.vercel.app

# MongoDB Connection String
# Copy from MongoDB Atlas dashboard
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# MongoDB Database Name (optional, defaults to fahm_ul_uloom)
MONGODB_DB=fahm_ul_uloom
